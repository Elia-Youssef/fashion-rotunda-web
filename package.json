{
  "name": "fashion-rotunda-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fashion Rotunda, web edition: an interactive showroom on three.js WebGPURenderer with WebGL 2 as the fallback.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run report",
    "deploy": "npm run build && wrangler pages deploy dist --project-name fashion-rotunda-web",
    "gpu:check": "node tools/gpu-check.mjs",
    "pipeline:unreal": "node pipeline/unreal/run.mjs",
    "pipeline:assemble": "node pipeline/gltf/assemble.mjs",
    "pipeline:optimize": "node pipeline/gltf/optimize.mjs",
    "pipeline:music": "node pipeline/audio/music.mjs",
    "report": "node pipeline/gltf/report.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "three": "0.186.0",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "lil-gui": "0.21.0",
    "meshoptimizer": "1.2.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
